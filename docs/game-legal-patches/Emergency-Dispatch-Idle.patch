+    transition: all 0.3s;
+    background: #e9ecef;
+    color: #495057;
+}
+
+.dispatch-button:hover:not(:disabled) {
+    transform: translateY(-2px);
+    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
+}
+
+.dispatch-button:disabled {
+    opacity: 0.5;
+    cursor: not-allowed;
+}
+
+.dispatch-button.police {
+    background: #3498db;
+    color: white;
+}
+
+.dispatch-button.fire {
+    background: #e74c3c;
