+<!DOCTYPE html>
+<html lang="de">
+<head>
+  <meta charset="UTF-8">
+  <title>Idle Game v2 – Space Colonies</title>
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+
+  <!-- Haupt-Styles -->
+  <link rel="stylesheet" href="../ui/style.css">
+  <link rel="stylesheet" href="../styles/visual-effects.css">
+  <link rel="icon" type="image/png" href="../favicon.png">
+</head>
+<body>
+  <div id="app">
+
+    <!-- Top-Bar: Ressourcen / Meta -->
+    <header class="stats-bar" id="statsBar">
+      <!-- Wird komplett von ui-render.js gefüllt -->
+      <!-- Theme Toggle Button (wird oben rechts positioniert) -->
+      <button id="themeToggle" class="theme-toggle" title="Theme wechseln (⏧+T)">
+        🌙
+      </button>
+    </header>
+
+    <!-- OPTION 1: Action Button sticky unter Stats Bar -->
+    <section class="actions" id="actions">
+      <!-- Buttons zum Sammeln / Aktionen, wird von ui-render.js gefüllt -->
+    </section>
+
+    <!-- OPTION 1: Upgrades Panel bekommt volle Breite -->
+    <section class="upgrades-panel">
+      <div class="tabs">
+        <button class="tab-btn active" data-tab="upgrades" title="Hotkey: 1">🏭 Upgrades</button>
+        <button class="tab-btn" data-tab="research" title="Hotkey: 2">🔬 Forschung</button>
+        <button class="tab-btn" data-tab="statistics" title="Hotkey: 3">📊 Statistiken</button>
+        <button class="tab-btn" data-tab="achievements" title="Hotkey: 4">🏆 Erfolge</button>
+        <button class="tab-btn" data-tab="prestige" title="Hotkey: 5">⭐ Prestige</button>
+      </div>
+
+      <div class="tab-content">
+        <!-- Normale Upgrades -->
+        <div class="upgrade-grid" id="upgradeGrid" data-tab="upgrades"></div>
+
+        <!-- Forschungs-Upgrades -->
+        <div class="upgrade-grid" id="researchGrid" data-tab="research" style="display:none;"></div>
+
+        <!-- Statistiken -->
+        <div id="statisticsContainer" data-tab="statistics" style="display:none;"></div>
+
+        <!-- Achievements -->
+        <div id="achievementsContainer" data-tab="achievements" style="display:none;"></div>
+        
+        <!-- Prestige -->
+        <div id="prestigeContainer" data-tab="prestige" style="display:none;"></div>
+      </div>
+    </section>
+
+    <!-- Hotkey-Hilfe (wird initial versteckt) -->
+    <div id="hotkeyHelp" class="hotkey-help" style="display:none;">
+      <div class="hotkey-help-content">
+        <h2>⌨️ Tastaturkürzel</h2>
+        <div class="hotkey-grid">
+          <div class="hotkey-section">
+            <h3>Navigation</h3>
+            <div class="hotkey-item"><kbd>1</kbd> - Upgrades</div>
+            <div class="hotkey-item"><kbd>2</kbd> - Forschung</div>
+            <div class="hotkey-item"><kbd>3</kbd> - Statistiken</div>
+            <div class="hotkey-item"><kbd>4</kbd> - Erfolge</div>
+            <div class="hotkey-item"><kbd>5</kbd> - Prestige</div>
+          </div>
+          <div class="hotkey-section">
+            <h3>Aktionen</h3>
+            <div class="hotkey-item"><kbd>Leertaste</kbd> - Energie sammeln</div>
+            <div class="hotkey-item"><kbd>Strg</kbd> + <kbd>S</kbd> - Speichern</div>
+            <div class="hotkey-item"><kbd>Strg</kbd> + <kbd>R</kbd> - UI neu laden</div>
+            <div class="hotkey-item"><kbd>⏧</kbd> + <kbd>T</kbd> - Theme wechseln</div>
+          </div>
+          <div class="hotkey-section">
+            <h3>Hilfe</h3>
+            <div class="hotkey-item"><kbd>H</kbd> oder <kbd>?</kbd> - Diese Hilfe</div>
+            <div class="hotkey-item"><kbd>ESC</kbd> - Hilfe schließen</div>
+          </div>
+        </div>
+        <button id="closeHotkeyHelp" class="close-help-btn">Schließen (ESC)</button>
+      </div>
+    </div>
+
+    <!-- Save / Import / Reset Bereich -->
+    <section class="save-panel">
+      <div class="save-controls">
+        <button id="exportBtn" class="save-btn">Export</button>
+        <button id="importBtn" class="save-btn">Import</button>
+        <button id="resetBtn" class="save-btn">Reset</button>
+        <button id="hotkeyBtn" class="save-btn" title="Tastaturkürzel anzeigen (H)">⌨️ Hotkeys</button>
+      </div>
+      <textarea id="saveString" class="save-textarea" rows="2" placeholder="Speicherstring hier einfügen oder kopieren"></textarea>
+    </section>
+  </div>
+
+  <!-- Einstiegspunkt – wichtig: Pfad relativ zum HTML -->
+  <script type="module" src="./main.js"></script>
+<nav aria-label="Rechtliche Hinweise" lang="de" style="position:fixed;bottom:6px;right:8px;z-index:20000;background:#151521;color:#eee;padding:4px 8px;border-radius:4px;display:flex;flex-wrap:wrap;gap:8px;font:12px/1.6 system-ui,sans-serif">
+<a style="color:inherit;text-decoration:underline" href="https://future-pulse.de/spiele-rechtliches/#impressum" target="_blank" rel="noopener noreferrer">Impressum</a>
+<a style="color:inherit;text-decoration:underline" href="https://future-pulse.de/spiele-rechtliches/#datenschutz" target="_blank" rel="noopener noreferrer">Datenschutz</a>
+<a style="color:inherit;text-decoration:underline" href="https://future-pulse.de/spiele-rechtliches/#lizenzen" target="_blank" rel="noopener noreferrer">Lizenzen</a>
+</nav>
+</body>
+</html>
